#!/usr/bin/env bash
set -euo pipefail

readonly max_resume_runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/atmux-max-resume"
readonly max_resume_marker="$max_resume_runtime_dir/complete"
readonly max_resume_boot_id_file="${ATMUX_MAX_BOOT_ID_FILE:-/proc/sys/kernel/random/boot_id}"
readonly max_resume_clay_script=/home/ryan/IdeaProjects/research/math-prize-problems/clay-max.sh
readonly max_resume_codex_home=/home/ryan/.codex
declare -a max_resume_created_ids=()
declare -a max_resume_created_names=()
declare -a max_resume_created_indices=()
declare -a max_resume_created_at=()

# Parallel, fixed-order arrays keep recovery deterministic and make rollback
# order the reverse of creation order. Identity is the native conversation ID,
# not a display label or a mutable pane PID.
readonly -a max_resume_names=(
  clay-p-vs-np-max
  clay-navier-stokes-max
  clay-hodge-max
  clay-bsd-max
  clay-yang-mills-max
  riemann-aristotle
  riemann-fable
  qwen-cve-59270
  kernel
)
readonly -a max_resume_directories=(
  /home/ryan/IdeaProjects/research/math-prize-problems/attacks/p-vs-np
  /home/ryan/IdeaProjects/research/math-prize-problems/attacks/navier-stokes
  /home/ryan/IdeaProjects/research/math-prize-problems/attacks/hodge-conjecture
  /home/ryan/IdeaProjects/research/math-prize-problems/attacks/birch-swinnerton-dyer
  /home/ryan/IdeaProjects/research/math-prize-problems/attacks/yang-mills
  /home/ryan/IdeaProjects/research/math-prize-problems
  /home/ryan/IdeaProjects/research/math-prize-problems
  /home/ryan/IdeaProjects/research/cve-research
  /home/ryan/IdeaProjects/qwen-kernel
)
readonly -a max_resume_harnesses=(codex codex codex codex codex codex claude claude codex)
readonly -a max_resume_profiles=(Default Default Default Default Default Default max qwen Default)
readonly -a max_resume_identities=(
  01a04598-ddc3-7923-aee9-1993d0fbe241
  01a04598-ddb6-7ae0-880b-3bca0a14ad1e
  01a04598-ddd3-7943-b109-26a0cad031d5
  01a04598-dde4-7e90-a839-ff0f4f23e77a
  01a04598-ddca-7462-b87d-57a99e32e371
  01a02c06-b75c-7553-8daf-d45ae8e52258
  6d2436ec-a5aa-4ab7-a4e2-5b8b76bd7d9f
  265df46d-f95a-4532-9cd5-59f3cabbac76
  01a03c8d-0826-7561-8a84-c16d95ac7a49
)
readonly -a max_resume_models=(
  gpt-5.6-sol gpt-5.6-sol gpt-5.6-sol gpt-5.6-sol gpt-5.6-sol
  gpt-5.6-sol fable qwen3.8-27b-mtp gpt-5.6-sol
